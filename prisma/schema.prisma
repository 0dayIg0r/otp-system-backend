generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  otps      Otp[]

  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])

  @@map("otps")
}
